# Production environment template. This file contains no real hostnames,
# endpoints, credentials, or secrets. Obtain all deployment values through the
# deployment configuration process; never copy local dev defaults.

# Required: production_settings_errors validates explicit production mode.
CHRONOBEAM_ENV=production

# Required: use a non-development PostgreSQL URL and protected DB transport. Do
# not put credentials in source control; use the approved secret delivery
# mechanism when the deployment platform supports it.
CHRONOBEAM_DATABASE_URL=

# Required: approved public HTTPS origin and OIDC configuration. The issuer,
# audience and subject claim contract come from the identity-provider
# registration; these blank values are intentionally not guesses.
CHRONOBEAM_PUBLIC_BASE_URL=
CHRONOBEAM_OIDC_DISCOVERY_URL=
CHRONOBEAM_OIDC_ISSUER=
CHRONOBEAM_OIDC_CLIENT_ID=
CHRONOBEAM_OIDC_AUDIENCE=

# Accepted values are none, basic, or post. Match the identity-provider
# registration; basic/post additionally require a secret from approved storage.
CHRONOBEAM_OIDC_CLIENT_AUTH_METHOD=none
# CHRONOBEAM_OIDC_CLIENT_SECRET=

# Safe same-origin defaults. Add only approved HTTPS origins or trusted proxy
# IPs/CIDRs when the deployment topology requires them.
CHRONOBEAM_CORS_ORIGINS=[]
CHRONOBEAM_LOG_LEVEL=INFO
CHRONOBEAM_FORWARDED_ALLOW_IPS=
# The production image sets this path in its Dockerfile; override only when
# using a different reviewed filesystem layout.
# CHRONOBEAM_FRONTEND_DIST=/app/frontend/dist

# Session/JWKS defaults from backend/app/config.py. Override only with approved
# deployment values; all TTLs must be positive and clock skew non-negative.
CHRONOBEAM_SESSION_IDLE_TTL_SECONDS=1800
CHRONOBEAM_SESSION_ABSOLUTE_TTL_SECONDS=28800
CHRONOBEAM_JWKS_CACHE_TTL_SECONDS=300
CHRONOBEAM_OIDC_CLOCK_SKEW_SECONDS=30

# Exact-subject registries fail closed when empty. Populate only after the
# employee mapping and the operator/recipient roles are in place.
CHRONOBEAM_RECIPIENT_SUBJECTS=
CHRONOBEAM_CUTOVER_OPERATOR_SUBJECTS=[]

# Rollout boundary is a deployment choice; leave blank until selected.
# Employee-entered planning features remain disabled by default.
CHRONOBEAM_ROLLOUT_BOUNDARY_MONTH=
CHRONOBEAM_ENABLE_SHIFT_PLAN_ENTRY=false
CHRONOBEAM_ENABLE_OCD_PLAN_ENTRY=false
CHRONOBEAM_ENABLE_SHIFT_2026_AUTHORITATIVE_COMPENSATION=false
CHRONOBEAM_ENABLE_SHIFT_CANCELLATION_3D_AUTO_ENTITLEMENT=false