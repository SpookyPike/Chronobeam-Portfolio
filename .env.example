# Chronobeam — development configuration (non-secret defaults).
# Copy this file to `.env` for local overrides. `.env` is gitignored.
# All values here are development-only; production configuration is
# deployment-specific and must not contain developer credentials.

# dev | test | production. IMPORTANT: unset defaults to production
# (fail-closed). Local development commands in the Justfile set dev
# explicitly. Production startup refuses to proceed when its safe-settings
# validation fails; an unconfigured OIDC boundary is a startup error.
CHRONOBEAM_ENV=dev

# Local development PostgreSQL (see compose.yaml). Service name: db.
CHRONOBEAM_DATABASE_URL=postgresql+psycopg://chronobeam:chronobeam_dev_only@127.0.0.1:55432/chronobeam
# Backup dump reads this setting. Restore/verify targets can instead use
# --database-url-env NAME (an exported process variable, not loaded from .env).
# URL TLS options sslmode/sslrootcert/sslcert/sslkey/sslcrl are preserved for
# backup child tools; other query options (including sslpassword) are refused.
# No TLS default is added. See docs/backup_restore.md for operator usage.

# Separate local database used by the test suite and the migration gate
# (chronobeam_test). Created on demand; the migration gate downgrades to
# base, which must never run against the seeded dev database.
CHRONOBEAM_TEST_DATABASE_URL=postgresql+psycopg://chronobeam:chronobeam_dev_only@127.0.0.1:55432/chronobeam_test

# JSON list of CORS origins for the local frontend dev server.
CHRONOBEAM_CORS_ORIGINS=["http://localhost:5173"]

# Safe defaults (production): INFO logging; trust no proxy forwarding headers;
# serve a compiled SPA from frontend/dist when present. Set the proxy IP/CIDR
# list only for the approved TLS-terminating proxy.
# CHRONOBEAM_LOG_LEVEL=INFO
# CHRONOBEAM_FORWARDED_ALLOW_IPS=192.0.2.10,2001:db8::/32
# CHRONOBEAM_FRONTEND_DIST=/srv/chronobeam/frontend/dist

# --- Production OIDC browser boundary -------------------------------------
# Required only when CHRONOBEAM_ENV=production. Values below are placeholders,
# not real deployment settings. Secrets belong in the approved secret store.
# CHRONOBEAM_DATABASE_URL=postgresql+psycopg://chronobeam:REPLACE_ME@db.example.invalid:5432/chronobeam
# CHRONOBEAM_CORS_ORIGINS=[]  # same-origin SPA; HTTPS origins only if needed
# CHRONOBEAM_PUBLIC_BASE_URL=https://chronobeam.example.invalid
# CHRONOBEAM_OIDC_DISCOVERY_URL=https://idp.example.invalid/.well-known/openid-configuration
# CHRONOBEAM_OIDC_ISSUER=https://idp.example.invalid
# CHRONOBEAM_OIDC_CLIENT_ID=chronobeam
# CHRONOBEAM_OIDC_AUDIENCE=chronobeam
# Accepted methods: none, basic, post. A client secret is required for
# basic/post; private_key_jwt is not implemented.
# CHRONOBEAM_OIDC_CLIENT_AUTH_METHOD=none
# CHRONOBEAM_OIDC_CLIENT_SECRET=          # basic/post only; never commit
# CHRONOBEAM_SESSION_IDLE_TTL_SECONDS=1800
# CHRONOBEAM_SESSION_ABSOLUTE_TTL_SECONDS=28800
# CHRONOBEAM_JWKS_CACHE_TTL_SECONDS=300
# CHRONOBEAM_OIDC_CLOCK_SKEW_SECONDS=30
# Static PEM is DEV/TEST-only regression support; ignored in production.
# CHRONOBEAM_OIDC_PUBLIC_KEY=

# --- Cutover operator allowlist -------------------------------------------
# JSON list of exact OIDC subjects permitted to POST
# /api/v1/cutover/opening-balances (one-time CUTOVER_SEED per employee).
# Login still requires this subject to map to a pre-existing active employee.
# The allowlist only adds CUTOVER_SEED_WRITE; it does not create or bypass the
# employee identity requirement. Unset/empty = nobody may seed (fail closed).
# Never grant this capability to technical-admin or HR.
# CHRONOBEAM_CUTOVER_OPERATOR_SUBJECTS=["cutover-operator@example.invalid"]

# --- Recipient registry ---------------------------------------------------
# Comma-separated exact principal subjects allowed as submission-package
# recipients / access-request grantees. In production ONLY this list applies:
# EMPTY MEANS FAIL CLOSED (no recipients configured -> every submission is
# blocked). A configured subject must ALSO hold an active SUBMISSION_RECIPIENT
# role assignment, otherwise the package would be unreadable and the submission
# is refused with an explicit error (operator-visible as
# "recipient_registry": "INCONSISTENT" on GET /api/v1/admin/system).
# Development/test fall back to the fixture recipients when this is unset.
# CHRONOBEAM_RECIPIENT_SUBJECTS=payroll-recipient@example.invalid,woco-recipient@example.invalid

# --- Employee plan entry --------------------------------------------------
# While no external shift-plan / OCD schedule source exists, the employee
# records their OWN planned shifts and OCD availability, so the confirm /
# deviation / shift-report / OCD-call / compensation workflows are usable
# without an external planner or admin preload. Recorded facts are labelled
# employee-recorded by provenance and are never treated as an approval.
#
# TWO independent switches, not one: authority can move per domain. When a
# shift-planning source becomes authoritative, turn OFF only
# CHRONOBEAM_ENABLE_SHIFT_PLAN_ENTRY and leave OCD employee-entered (or the
# reverse). Turning one domain off never affects the other. Existing rows stay
# readable and remain consumed by the unchanged downstream workflows.
#
# Both default to false (gated-feature posture). Enable explicitly in
# demo deployments only. A same-owner create retry still succeeds after a
# switch is turned off (an already-committed command is not a new mutation).
# CHRONOBEAM_ENABLE_SHIFT_PLAN_ENTRY=true
# CHRONOBEAM_ENABLE_OCD_PLAN_ENTRY=true

# --- Deployment boundary --------------------------------------------------
# Earliest month (YYYY-MM) in which the service is usable at all. Unset means
# no additional lower bound beyond the installed policy/calendar coverage.
# CHRONOBEAM_ROLLOUT_BOUNDARY_MONTH=

# --- Narrow policy gates --------------------------------------------------
# Both default to false. Enabling one does not resolve the underlying blocked
# policy; the exact semantics and decision authority are still open.
# CHRONOBEAM_ENABLE_SHIFT_2026_AUTHORITATIVE_COMPENSATION=false
# CHRONOBEAM_ENABLE_SHIFT_CANCELLATION_3D_AUTO_ENTITLEMENT=false