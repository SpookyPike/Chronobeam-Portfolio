{
  "name": "chronobeam-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Chronobeam — employee-owned working-time service frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "knip:development": "knip --config knip.development.json",
    "depcruise": "depcruise src e2e vite.config.ts playwright.config.ts",
    "depcruise:development": "depcruise --config .dependency-cruiser.development.cjs src demo e2e vite.config.ts playwright.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@swc/core": "^1.16.22",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dependency-cruiser": "^18.7.2",
    "jsdom": "^30.1.3",
    "knip": "^6.44.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.24.0"
}
